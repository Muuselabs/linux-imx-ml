// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "x1000.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/ingenic,tcu.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "muuselabs,j2000", "ingenic,x1000";
	model = "Muuselabs Jooki J2000";

	aliases {
		serial2 = &uart2;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x02000000>;
	};

	sound_halley2_icdc {
		status = "ok";
		compatible = "ingenic,x1000-sound";
		ingenic,model = "halley2";
		ingenic,dai-link = "i2s-icdc";
		ingenic,stream = "main";
		ingenic,cpu-dai = <&i2s>;
		ingenic,platform = <&aic>;
		ingenic,codec = <&codec>;
		ingenic,codec-dai = "icdc-d3-hifi";
		ingenic,audio-routing = "Speaker", "DO_LO_PWM";
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&ost {
	counting-frequency = <1500000>;
};

&tcu {
	/* 1500 kHz for the system timer */
	assigned-clocks = <&tcu TCU_CLK_TIMER7>;
	assigned-clock-rates = <1500000>;

	/* Use channel #8 for the system timer */
	ingenic,pwm-channels-mask = <0x7f>;
};

&i2c0 {
	status = "okay";

	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;
};

&i2c2 {
	status = "okay";

	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c2>;

    pmic: j2000_ht@0A {
		compatible = "muuselabs,j2000-ht";
		reg = <0x0A>;
	};
};

&uart0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart0>;
};

&uart2 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart2>;
};

&otg {
	status = "okay";
	dr_mode = "peripheral";

	/* to fix issues with the g_audio gadget*/
	g-np-tx-fifo-size = <384>;
	g-tx-fifo-size = <384 256 256 256 256 256 256 512>;
};

&msc0 {
	status = "okay";

	bus-width = <4>;
	max-frequency = <19000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_msc0>;

	non-removable;
};

&msc1 {
	status = "okay";

	bus-width = <4>;
	max-frequency = <11320760>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_msc1>;

    /* non-removable; */
    broken-cd;
   /* cd-gpios = <&gpc 17 GPIO_ACTIVE_HIGH>; */
};

&aic {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_pins>;
};

&pinctrl {
	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data";
		bias-pull-up;
	};

	pins_i2c2: i2c2 {
		function = "i2c2";
		groups = "i2c2-data";
		bias-pull-up;
	};

	pins_uart0: uart0 {
		function = "uart0";
		groups = "uart0-data", "uart0-hwflow";
		bias-disable;
	};

	pins_uart2: uart2 {
		function = "uart2";
		groups = "uart2-data-d";
		bias-disable;
	};

	pins_msc0: msc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit", "mmc0-8bit";
		bias-pull-up;
	};

	pins_msc1: msc1 {
		function = "mmc1";
		groups = "mmc1-1bit", "mmc1-4bit";
		bias-pull-up;
	};

	i2s_pins:i2s_pins {
		function = "i2s";
		groups = "i2s";
		bias-disable;
	};
};

/* Keys control */
/ {
	keys {
		compatible = "gpio-keys";

		/* PCB before MSB */
		int_old {
			label = "INT_OLD";
			gpios = <&gpc 24 GPIO_ACTIVE_LOW>;
			linux,code = <152>;
		};
		/* needs patch on board */
        btn_old {
			label = "BTN_OLD";
			gpios = <&gpa 30 GPIO_ACTIVE_LOW>;
			linux,code = <207>;
		};

		/* PCB from MSB on */
		int {
			label = "INT";
			gpios = <&gpb 28 GPIO_ACTIVE_LOW>;
			linux,code = <152>;
		};
		btn {
			label = "BTN";
			gpios = <&gpb 31 GPIO_ACTIVE_LOW>;
			linux,code = <207>;
		};
	};
};
