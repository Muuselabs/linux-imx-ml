// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "x1000.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/ingenic,tcu.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "muuselabs,j2000", "ingenic,x1000";
	model = "Muuselabs Jooki J2000";

	aliases {
		serial2 = &uart2;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x04000000>;
	};

	sound_halley2_icdc {
		status = "ok";
		compatible = "ingenic,x1000-sound";
		ingenic,model = "halley2";
		ingenic,dai-link = "i2s-icdc";
		ingenic,stream = "main";
		ingenic,cpu-dai = <&i2s>;
		ingenic,platform = <&aic>;
		ingenic,codec = <&codec>;
		ingenic,codec-dai = "icdc-d3-hifi";
		ingenic,audio-routing = "Speaker", "DO_LO_PWM";
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&ost {
	counting-frequency = <1500000>;
};

&tcu {
	/* 1500 kHz for the system timer */
	assigned-clocks = <&tcu TCU_CLK_TIMER7>;
	assigned-clock-rates = <1500000>;

	/* Use channel #8 for the system timer */
	ingenic,pwm-channels-mask = <0x7f>;
};

&i2c0 {
	status = "okay";

	clock-frequency = <400000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;
};

&uart0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart0>;
};

&uart2 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart2>;
};

&ssi {
	status = "okay";

	spi-max-frequency = <50000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_ssi>;
};

&otg {
	status = "okay";
	dr_mode = "peripheral";
};

&msc0 {
	status = "okay";

	bus-width = <4>;
	max-frequency = <50000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_msc0>;

	non-removable;
};

&msc1 {
	status = "okay";

	bus-width = <4>;
	max-frequency = <500000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_msc1>;

    non-removable;
   /* cd-gpios = <&gpc 17 GPIO_ACTIVE_HIGH>; */
};

&pinctrl {
	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data";
		bias-disable;
	};

	pins_uart0: uart0 {
		function = "uart0";
		groups = "uart0-data", "uart0-hwflow";
		bias-disable;
	};

	pins_uart2: uart2 {
		function = "uart2";
		groups = "uart2-data-d";
		bias-disable;
	};

	pins_ssi: ssi {
		function = "ssi";
		groups = "ssi-dt-d", "ssi-dr-d", "ssi-clk-d", "ssi-ce0-d";
		bias-disable;
	};

	pins_mac: mac {
		function = "mac";
		groups = "mac";
		bias-disable;
	};

	pins_msc0: msc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit", "mmc0-8bit";
		bias-disable;
	};

	pins_msc1: msc1 {
		function = "mmc1";
		groups = "mmc1-1bit", "mmc1-4bit";
		bias-pull-up;
	};

	i2s_pins:i2s_pins {
		function = "i2s";
		groups = "i2s";
		bias-disable;
	};
};
